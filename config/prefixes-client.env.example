# Per-client origin hostname prefixes (one label per line).
# __CLIENT__ is replaced with each client name from /etc/proxies/clients/<name>.env
# Resulting hostname: <prefix>.<current-domain>
#
# The client name must be EGT's casino identifier, lowercased with the underscore
# removed: DN_BAHISBEY -> dnbahisbey. Both the "dn" prefix and the "-bgsp" suffix
# are required - EGT's ingress does not recognise the label without them, and an
# unrecognised label is dropped rather than refused, so the symptom is a request
# that hangs rather than an error.
#
# Both naming forms are listed because EGT are migrating off "-bgsp" brand by
# brand, so a brand that flips keeps working. Check a label with:
#     curl -sk --connect-to "<label>.probe.example:443:p4.fpp-ong.com:443" \
#          -o /dev/null -w '%{http_code}\n' https://<label>.probe.example/
# Any HTTP code means the label routes; 000 means it does not.

__CLIENT__-gs-prod-bgsp
__CLIENT__-gs-demo-prod-bgsp
__CLIENT__-lobby-prod-bgsp
__CLIENT__-api-prod-bgsp
__CLIENT__-gc-prod-bgsp

__CLIENT__-gs-prod
__CLIENT__-gs-demo-prod
__CLIENT__-lobby-prod
__CLIENT__-api-prod
__CLIENT__-gc-prod
